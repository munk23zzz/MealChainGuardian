# MealChain Guardian — environment lokal (docs/Architecture.md §4)
# Salin file ini jadi `.env` lalu sesuaikan. JANGAN commit `.env`.

# --- Postgres (docker compose) -------------------------------------------------
POSTGRES_USER=mealchain
POSTGRES_PASSWORD=mealchain
POSTGRES_DB=mealchain
POSTGRES_PORT=55432

# Dipakai backend. Skema: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://mealchain:mealchain@localhost:55432/mealchain

# --- Mock SAP ------------------------------------------------------------------
# Dari mana MockSAPProvider membaca: memory (tanpa DB, dipakai test) | postgres
SAP_MOCK_STORE=postgres

# Saklar per kapabilitas (docs/Architecture.md §9.2). Default: mock.
# Pilihan: mock | aws_mcp | odata
SAP_MATERIAL_STOCK_MODE=mock
SAP_PURCHASE_ORDER_MODE=mock
SAP_BUSINESS_PARTNER_MODE=mock
SAP_PRODUCT_MASTER_MODE=mock
SAP_MATERIAL_DOCUMENT_MODE=mock
