# MealChain Guardian — environment lokal (docs/Architecture.md §4)
# Salin file ini jadi `.env` lalu sesuaikan. JANGAN commit `.env`.

# --- Postgres (docker compose) -------------------------------------------------
POSTGRES_USER=mealchain
POSTGRES_PASSWORD=mealchain
POSTGRES_DB=mealchain
POSTGRES_PORT=55432

# Dipakai backend. Skema: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://mealchain:mealchain@localhost:55432/mealchain

# --- Auth ----------------------------------------------------------------------
# Kunci tanda tangan token demo. WAJIB diisi di lingkungan lomba; kalau kosong, backend
# memakai nilai pengembangan (bisa dipalsukan siapa pun yang tahu nilainya).
APP_SECRET_KEY=

# Origin yang boleh memanggil API dari peramban (CORS), dipisah koma.
# Kosong = default dev: http://localhost:3000,http://127.0.0.1:3000
# Contoh menambah situs demo / VPS:
# APP_CORS_ORIGINS=http://localhost:3000,https://munk23zzz.github.io
APP_CORS_ORIGINS=

# --- Mock SAP ------------------------------------------------------------------
# Dari mana MockSAPProvider membaca: memory (tanpa DB, dipakai test) | postgres
SAP_MOCK_STORE=postgres

# Saklar per kapabilitas (docs/Architecture.md §9.2). Default: mock.
# Pilihan: mock | aws_mcp | odata
SAP_MATERIAL_STOCK_MODE=mock
SAP_PURCHASE_ORDER_MODE=mock
SAP_BUSINESS_PARTNER_MODE=mock
SAP_PRODUCT_MASTER_MODE=mock
SAP_MATERIAL_DOCUMENT_MODE=mock

# --- Ambang kesegaran (docs/Skill.md §3) ---------------------------------------
# Gerbang hard constraint: `freshness_score` di bawah nilai ini TIDAK layak jadi kandidat alokasi
# (stok fisiknya tetap terlihat, tapi tidak dihitung sebagai stok terpakai).
# Kosong = default 0.60. Nilai di luar 0..1 atau bukan angka diabaikan (kembali ke default).
# Pita status (0.85 / 0.60) TIDAK diatur di sini — itu keputusan dokumen, ada di
# `backend/app/core/freshness.py` supaya ikut unit test.
FRESHNESS_GATE_THRESHOLD=0.60
